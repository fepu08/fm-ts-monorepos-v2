{
  "name": "@seeds/server",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev-server": "tsx --watch --watch-preserve-output src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint .",
    "format": "prettier --write src/**/*.{ts,svelte} tests/**/*.ts {tailwind.config.js,postcss.config.cjs,vite.config.ts,svelte.config.js,eslint.config.mts}"
  },
  "devDependencies": {
    "@microsoft/api-documenter": "^7.26.27",
    "@microsoft/api-extractor": "^7.52.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.3",
    "tsx": "^4.20.0",
    "typescript": "~5.8.3",
    "vitest": "^3.2.3"
  },
  "dependencies": {
    "@seeds/models": "workspace:*",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "winston": "^3.17.0",
    "yaml": "^2.8.0"
  }
}
